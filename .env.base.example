# Settings for the bridge of the Dataspeed MOBILITY BASE a robot stands on.
# The base is a ROS 1 system of its own, on the computer inside the base, so it gets a
# bridge of its own next to the robot's. Copy to .env.base, fill in the values marked
# FILL IN, and name the file in every command for the base:
#   docker compose --env-file .env.base up -d bridge
# See docs/mobility-base.md. The robot's own settings stay in .env.

# --- The base's computer ----------------------------------------------------------------------
# Its name, as the command "hostname" prints it on that computer (the lab's base: NUC),
# and its address on the network this machine shares with it.
# FILL IN
ROBOT_HOSTNAME=NUC
# FILL IN
ROBOT_IP=169.254.x.x
# The base's own ROS 1 system. Use the NAME here, exactly as above.
ROS_MASTER_URI=http://NUC:11311

# --- This machine -----------------------------------------------------------------------------
# This machine's address on that network (the same as ROS_IP in the robot's file if robot
# and base are on one switch).
# FILL IN
ROS_IP=169.254.x.x

# --- What makes this bridge the base's --------------------------------------------------------
# The list of the base's topics instead of the robot's.
BRIDGE_CONFIG=/config/mobility_base.yaml
# A name of its own for the bridge's helpers, so that they do not collide with those of the
# robot's bridge.
BRIDGE_PARAM_NS=/base_bridge
# A name of its own for this bridge's container, so that it can run next to the robot's.
COMPOSE_PROJECT_NAME=baxter-base
# Only if the robot standing on the base has a name (docs/two-robots.md): the SAME name
# here. The base's topics then appear under it too (/two/mobility_base/...), and in
# programs the base is that robot's: Robot('two').MobilityBase().
# ROBOT_NAME=two

# --- As in .env -------------------------------------------------------------------------------
# The same ROS 2 domain as the robot's bridge: programs use robot and base together.
ROS_DOMAIN_ID=42
# The base's list needs fixed_list.
BRIDGE_MODE=fixed_list
# DDS_PROFILE=wsl
