# Settings for running against a SIMULATED robot instead of a real one.
# Copy to .env.sim (nothing to fill in) and name it in every command:
#   docker compose --env-file .env.sim up -d sim
# See docs/simulation.md. The real robot's settings stay in .env, untouched.
#
# For TWO simulated robots next to each other, copy this file twice, to .env.sim1 and
# .env.sim2, and set the lines marked "two simulators" in both (docs/simulation.md, "Two
# simulated robots").

# --- The "robot": a simulator on this machine ------------------------------------------------
ROBOT_HOSTNAME=localhost
ROBOT_IP=127.0.0.1
ROS_IP=127.0.0.1
# The simulator's own ROS 1 system. Two simulators: the second one needs another port,
# 11312.
ROS_MASTER_URI=http://127.0.0.1:11311
# The simulated robot always has Rethink's electric gripper on both arms: MoveIt plans with
# them (docs/moveit.md).
LEFT_ELECTRIC_GRIPPER=1
RIGHT_ELECTRIC_GRIPPER=1

# --- Simulator --------------------------------------------------------------------------------
# The port Gazebo itself uses. Two simulators: 11346 for the second.
SIM_GAZEBO_PORT=11345
# false: run without Gazebo's window (less work for the processor).
# SIM_WINDOW=false
# On WSL2: draw with the computer's graphics card instead of on the processor. About ten
# times as many camera pictures per second (docs/simulation.md, "Graphics card").
# COMPOSE_FILE=compose.yaml:compose.wsl-gpu.yaml

# --- What keeps robots apart ------------------------------------------------------------------
# The ROS 2 domain of the simulated robots. A different one than the real robots' (42),
# so that a program started with the wrong settings talks to nothing instead of to the
# wrong robot. Two simulators: the same number in both files.
ROS_DOMAIN_ID=43
# The name of this simulator's containers. Two simulators: baxter-sim1 and baxter-sim2.
COMPOSE_PROJECT_NAME=baxter-sim
# Two simulators only: a name for each robot, sim1 and sim2 (docs/two-robots.md), and
# where each stands in pictures of both (x y z in metres, turn in degrees).
# ROBOT_NAME=sim1
# ROBOT_POSITION=0 0 0 0

# --- Simulation time --------------------------------------------------------------------------
# The simulation runs slower than real time on a busy computer. With this, the bridge
# carries the simulation's clock, and arm paths (the joint trajectory action server,
# MoveIt) are timed by it: a slow simulation then takes them more slowly instead of
# stopping them because the arm falls behind. Leave it on.
SIM_TIME=1

# --- Bridge -----------------------------------------------------------------------------------
BRIDGE_MODE=fixed_list
# As in .env: set to wsl if this machine is WSL2 with mirrored networking (not NAT or bridged).
# DDS_PROFILE=wsl
