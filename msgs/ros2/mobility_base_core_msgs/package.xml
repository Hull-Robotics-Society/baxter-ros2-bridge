<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobility_base_core_msgs</name>
  <version>1.0.6</version>
  <description>
    ROS 2 port of mobility_base_core_msgs from Dataspeed's Mobility Base SDK (mobility_base_ros 1.0.6), for use
    with ros1_bridge. Generated by scripts/port_msgs_to_ros2.py; do not edit by hand.
  </description>

  <maintainer email="Techniksam@users.noreply.github.com">Samuel Galla</maintainer>
  <license>BSD-3-Clause</license>
  <author>Dataspeed Inc.</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
