<?xml version="1.0" encoding="UTF-8"?>
<!-- What MoveIt needs to know about Baxter beyond the robot model: which joints form an
     arm, named postures, and which pairs of parts never need a collision check.

     Groups, end effectors and postures are those of the configuration Rethink Robotics
     and MoveIt shipped for Baxter (reference/moveit_robots_baxter, baxter_base.srdf.xacro),
     with the hand's tip at left_gripper / right_gripper as its default.

     GENERATED from config/baxter.srdf.in by scripts/make_srdf.py: do not edit this
     file; change baxter.srdf.in and run the script. -->
<robot name="baxter">
  <group name="left_arm">
    <chain base_link="torso" tip_link="left_gripper"/>
  </group>
  <group name="right_arm">
    <chain base_link="torso" tip_link="right_gripper"/>
  </group>
  <group name="both_arms">
    <group name="right_arm"/>
    <group name="left_arm"/>
  </group>
  <group name="left_hand">
    <chain base_link="left_hand" tip_link="left_gripper"/>
  </group>
  <group name="right_hand">
    <chain base_link="right_hand" tip_link="right_gripper"/>
  </group>

  <!-- The hands, as MoveIt's "end effectors": what is dragged in RViz. -->
  <end_effector name="left_hand_eef" parent_link="left_gripper" group="left_hand" parent_group="left_arm"/>
  <end_effector name="right_hand_eef" parent_link="right_gripper" group="right_hand" parent_group="right_arm"/>

  <!-- Named postures, as in the original. They are Limb.move_to_neutral()'s posture. -->
  <group_state name="left_neutral" group="left_arm">
    <joint name="left_e0" value="0"/>
    <joint name="left_e1" value="0.75"/>
    <joint name="left_s0" value="0"/>
    <joint name="left_s1" value="-0.55"/>
    <joint name="left_w0" value="0"/>
    <joint name="left_w1" value="1.26"/>
    <joint name="left_w2" value="0"/>
  </group_state>
  <group_state name="right_neutral" group="right_arm">
    <joint name="right_e0" value="0"/>
    <joint name="right_e1" value="0.75"/>
    <joint name="right_s0" value="0"/>
    <joint name="right_s1" value="-0.55"/>
    <joint name="right_w0" value="0"/>
    <joint name="right_w1" value="1.26"/>
    <joint name="right_w2" value="0"/>
  </group_state>
  <!-- Not in the original: the same for both arms at once. -->
  <group_state name="both_neutral" group="both_arms">
    <joint name="left_e0" value="0"/>
    <joint name="left_e1" value="0.75"/>
    <joint name="left_s0" value="0"/>
    <joint name="left_s1" value="-0.55"/>
    <joint name="left_w0" value="0"/>
    <joint name="left_w1" value="1.26"/>
    <joint name="left_w2" value="0"/>
    <joint name="right_e0" value="0"/>
    <joint name="right_e1" value="0.75"/>
    <joint name="right_s0" value="0"/>
    <joint name="right_s1" value="-0.55"/>
    <joint name="right_w0" value="0"/>
    <joint name="right_w1" value="1.26"/>
    <joint name="right_w2" value="0"/>
  </group_state>

  <!-- The robot stands still in the room: its base is fixed to the frame "world". (The
       original makes this joint "floating" and passive, for a robot that moves; with no
       position of the robot in the room given, MoveIt treats both the same.) -->
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base"/>

  <!-- For Baxter with no electric gripper. Pairs of parts that are never checked against each
       other: 272 from the original configuration (reference/moveit_robots_baxter;
       10 left out because they name parts this robot model does not have) and
       6 from baxter.srdf.in, where each says why. -->
  <disable_collisions link1="collision_head_link_1" link2="collision_head_link_2" reason="Adjacent"/>
  <disable_collisions link1="collision_head_link_1" link2="display" reason="Adjacent"/>
  <disable_collisions link1="collision_head_link_1" link2="head" reason="Never"/>
  <disable_collisions link1="collision_head_link_1" link2="left_lower_shoulder" reason="Never"/>
  <disable_collisions link1="collision_head_link_1" link2="left_upper_elbow" reason="Never"/>
  <disable_collisions link1="collision_head_link_1" link2="left_upper_shoulder" reason="Never"/>
  <disable_collisions link1="collision_head_link_1" link2="pedestal" reason="Never"/>
  <disable_collisions link1="collision_head_link_1" link2="right_lower_shoulder" reason="Never"/>
  <disable_collisions link1="collision_head_link_1" link2="right_upper_elbow_visual" reason="Never"/>
  <disable_collisions link1="collision_head_link_1" link2="right_upper_shoulder" reason="Never"/>
  <disable_collisions link1="collision_head_link_1" link2="screen" reason="Never"/>
  <disable_collisions link1="collision_head_link_1" link2="sonar_ring" reason="Never"/>
  <disable_collisions link1="collision_head_link_1" link2="torso" reason="Adjacent"/>
