# Settings for the bridge. scripts/add_robot.sh writes .env from this file, with the four
# values marked FILL IN filled in; by hand: copy it to .env and fill them in.
# .env is not committed: each computer has its own addresses. Several robots: one file per
# robot (docs/two-robots.md).

# --- The robot --------------------------------------------------------------------------
# Its name on the network. Baxter's name is its serial number, e.g. 011310P0012.local
# (on a sticker on the robot).
# FILL IN
ROBOT_HOSTNAME=011xxxPxxxx.local

# Its address. On a computer that can already reach it:
#   getent hosts 011xxxPxxxx.local        or        ping -c 1 011xxxPxxxx.local
# Why both name and address: ROS 1 programs on the robot announce themselves by NAME, and
# Docker containers cannot look up .local names. compose.yaml passes this pair into the
# containers, so that the name resolves there.
# FILL IN
ROBOT_IP=192.168.x.x

# Optional second name of the same robot. The robot's own programs may announce themselves
# under another name than the one used above, typically <serial>.local when the lab uses
# a full name such as <serial>.some.university. Setting it does no harm if it is unused.
# ROBOT_HOSTNAME_2=011xxxPxxxx.local

# Optional: a second computer whose programs are part of the robot's ROS 1 system, for
# example the own computer of a Mobility Base the robot stands on. Its programs announce
# themselves under that computer's name, which the containers cannot look up either.
# The inventory (docker compose run --rm inventory) lists such computers in machines.txt
# and says if one cannot be reached.
# BASE_HOSTNAME=name-of-the-base-computer
# BASE_IP=192.168.x.x

# The ROS 1 master runs on the robot. Use the NAME here, exactly as above.
# FILL IN (same name as ROBOT_HOSTNAME)
ROS_MASTER_URI=http://011xxxPxxxx.local:11311

# Optional, for MoveIt (docs/moveit.md, "Grippers"): 1 if Rethink's electric gripper is
# mounted on that arm. MoveIt then checks the gripper's parts for collisions correctly
# (its shape comes from the robot's model). MoveIt warns at its start when this and the
# robot's model disagree.
# LEFT_ELECTRIC_GRIPPER=0
# RIGHT_ELECTRIC_GRIPPER=0

# --- This machine -----------------------------------------------------------------------
# This machine's address ON THE NETWORK THE ROBOT IS ON, as the robot sees it:
#   ip -4 -br addr        (the line of the bridged network adapter, same range as ROBOT_IP)
# The robot connects back to this address to receive commands. With a wrong address,
# reading works but commands (enable, move) never arrive.
# FILL IN
ROS_IP=192.168.x.x

# --- Bridge -------------------------------------------------------------------------------
# fixed_list: only the topics and services in bridge_config/topics.yaml are carried, all
#             the time. The mode to work in: on the robot (7 Oct 2026) everything arrived
#             evenly, 100 joint states per second.
# on_demand:  everything on the robot is reachable from ROS 2 without a list, and a topic
#             is only carried while a program uses it. For looking around, not for moving
#             the robot: on the real robot this mode pauses all data for about 0.4 s once
#             per second (see docker/bridge-jazzy/README.md).
BRIDGE_MODE=fixed_list

# Optional: 0 switches off the bridge's guard, which restarts the part of the bridge that
# waits for good for a robot service that never answers (docker/bridge-jazzy/README.md).
# BRIDGE_GUARD=0

# --- Your programs ----------------------------------------------------------------------
# Optional: the folder your own programs are in. 'docker compose run --rm client' starts
# in it. Without it, the container starts in this repository's folder.
# PROJECT_DIR=/home/you/my_baxter_programs

# Optional, for 'docker compose run --rm rviz': 0 lets RViz use the graphics card's own
# driver (faster). The default, 1, draws without it, which also works in a VM.
# RVIZ_SOFTWARE_RENDERING=0
# On WSL2 use this line instead: it passes Windows' graphics driver into the container
# (see compose.wsl-gpu.yaml).
# COMPOSE_FILE=compose.yaml:compose.wsl-gpu.yaml

# --- ROS 2 --------------------------------------------------------------------------------
# ROS 2 domain the bridged topics appear in. Every ROS 2 machine that wants to talk to
# Baxter uses the same number; other ROS 2 traffic in the lab stays separate.
ROS_DOMAIN_ID=42

# ROS 2 network settings, a file from bridge_config/dds/. Leave it out on a normal Linux
# machine or VM. Set it to wsl if the bridge machine is WSL2 with mirrored networking:
# without it, ROS 2 programs there do not find each other (see docs/bridge-machine.md).
# Leave it out with WSL in NAT or bridged mode, as on the lab machines
# (wslinfo --networking-mode; see docs/lab-machines.md).
# After changing it:  docker compose up -d bridge
# DDS_PROFILE=wsl

# How far ROS 2 looks for other programs. LOCALHOST: this machine only. Use it on the lab
# machines, where every WSL is on the same university network and would otherwise see
# every other lab machine's bridge. Set the same value in your own shell
# (export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST). Leave it out to reach other computers
# (docs/own-machine.md).
# ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

# --- Images -------------------------------------------------------------------------------
# Where 'docker compose pull' gets the ready-made images from. Only change it for a copy
# of the repository that publishes its own images.
# BAXTER_IMAGES=ghcr.io/hull-robotics-society
